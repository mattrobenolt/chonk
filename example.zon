// Example chonk pack config. Try it:
//
//   ./zig-out/bin/chonk pack zig-out/bin/stub example.zon fat && ./fat
//
// Variant order IS priority: the first variant whose conditions all pass
// wins, else the fallback. Condition evaluation lands with §7 step 6 — until
// then the stub answers "this stub dispatches exactly one variant".
.{
    .variants = .{
        // Neoverse V2 and friends — the SVE2 extension family. A bit name
        // implies its source (sve2 is an AT_HWCAP2 bit); the enum is checked
        // at parse time, so a typo is a line:column parse error.
        .{
            .name = "neoverse-v2",
            .binary = "zig-out/bin/chonk", // swap for your -march build
            .match = .{
                .{ .bit = .sve2 },
            },
        },

        // Neoverse V1 — SVE without SVE2. (Any system path works; this one
        // is NixOS-flavored — use whatever binaries live on your box.)
        .{
            .name = "neoverse-v1",
            .binary = "/run/current-system/sw/bin/true",
            .match = .{
                .{ .bit = .sve },
            },
        },

        // The fallback: no match, no name — display metadata is optional.
        .{
            .binary = "/run/current-system/sw/bin/true",
        },
    },
}
